// prisma/schema.prisma
// En Prisma v7 la URL ya NO va aquí — va en prisma.config.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url se quitó en Prisma v7 — se configura en prisma.config.ts
}

model Task {
  id        Int      @id @default(autoincrement())
  title     String
  priority  String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
